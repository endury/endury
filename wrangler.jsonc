// Cloudflare deploy of the static site `make site` builds: Workers static
// assets, no Worker script. `make deploy` builds and uploads it. Hosting your
// own copy: change `name` and the `routes` pattern to a domain in your
// Cloudflare account (or drop `routes` and set "workers_dev": true).
{
  "name": "endury",
  "compatibility_date": "2026-09-21",
  "assets": {
    "directory": "./site"
  },
  "routes": [{ "pattern": "endury.app", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false
}
