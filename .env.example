# Endury local runtime env: copy to .env (which git ignores) and fill in.
#
# Only uncommented lines are required. Everything else has sensible defaults
# in CoachConfig — uncomment and override as needed.
#
# The training planner (planner) is fully deterministic and needs no key.

# ── Required for coach chat ─────────────────────────────────────────────

# Uncomment and paste your real key (https://openrouter.ai/keys). Without
# it, coach chat is disabled but the planner and all data views work.
# OPENROUTER_API_KEY=your_openrouter_key_here

# ── Models (OpenRouter slugs) ───────────────────────────────────────────

# One model serves every coach turn; there is no cheap/strong tier.
# MODEL=anthropic/claude-haiku-5.5

# OpenRouter reasoning-effort override for the model above: none, low,
# medium, high, xhigh, or max. Default low: the default model reasons at
# length when the field is omitted. Never none: some models refuse it.
# MODEL_REASONING_EFFORT=

# ── OpenRouter tuning (rarely needed) ───────────────────────────────────

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_TIMEOUT_S=60
# OPENROUTER_MAX_RETRIES=3
# OPENROUTER_RETRY_BACKOFF_MS=500

# ── Required for training data (intervals.icu) ──────────────────────────

# Create at intervals.icu -> Settings -> Developer Settings. The API's
# username field is literally "API_KEY"; paste the generated key here.
# Without it, the planner has no history/thresholds to seed from and plans
# refuse to generate for goal sports it can't measure.
# INTERVALS_API_KEY=your_intervals_key_here

# ── intervals.icu tuning (rarely needed) ────────────────────────────────

# INTERVALS_ATHLETE_ID=0   # "0" means the authenticated athlete
# INTERVALS_BASE_URL=https://intervals.icu/api/v1
